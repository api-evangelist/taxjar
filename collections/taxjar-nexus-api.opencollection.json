{
  "opencollection": "1.0.0",
  "info": {
    "name": "TaxJar Sales Tax Categories Nexus API",
    "version": "2.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Nexus",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List nexus regions",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.taxjar.com/v2/nexus/regions"
          },
          "docs": "Returns a list of nexus regions (states/countries where you have tax nexus) for the authenticated account."
        }
      ]
    }
  ],
  "bundled": true
}