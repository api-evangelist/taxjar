                  "value": "<string>",
                  "description": "Two-letter ISO country code"
                },
                {
                  "disabled": false,
                  "key": "state",
                  "value": "<string>",
                  "description": "Two-letter state/province code"
                },
                {
                  "disabled": false,
                  "key": "city",
                  "value": "<string>",
                  "description": "City name"
                },
                {
                  "disabled": false,
                  "key": "street",
                  "value": "<string>",
                  "description": "Street address"
                }
              ],
              "variable": [
                {
                  "disabled": false,
